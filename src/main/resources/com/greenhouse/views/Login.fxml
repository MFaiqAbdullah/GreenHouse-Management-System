<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greenhouse.controllers.LoginController" styleClass="login-container">
    <padding>
        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0"/>
    </padding>

    <Label text="GreenHouse Management System" styleClass="title-label"/>
    
    <VBox spacing="5.0">
        <Label text="Username:"/>
        <TextField fx:id="usernameField" promptText="Enter username"/>
    </VBox>
    
    <VBox spacing="5.0">
        <Label text="Password:"/>
        <PasswordField fx:id="passwordField" promptText="Enter password"/>
    </VBox>
    
    <Label fx:id="errorLabel" textFill="RED" visible="false"/>
    
    <Button text="Login" onAction="#handleLogin" defaultButton="true" styleClass="primary-button"/>
</VBox>
